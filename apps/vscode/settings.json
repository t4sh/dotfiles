{
    "activitusbar.combineWorkspaceSettings": true,
    "activitusbar.searchViewInPanel": true,
    "activitusbar.showSourceControlCounter": true,
    "activitusbar.toggleSidebar": false,
    "activitusbar.views": [
        {
            "name": "explorer",
            "codicon": "files"
        },
        {
            "name": "scm",
            "codicon": "source-control"
        },
        {
            "name": "extensions",
            "codicon": "extensions"
        },
        {
            "name": "search",
            "codicon": "search"
        },
        {
            "codicon": "kebab-vertical"
        },
        // {
        //     "name": "debug",
        //     "codicon": "debug-alt"
        // },
        // {
        //     "name": "settings",
        //     "codicon": "gear"
        // },
    ],
    "breadcrumbs.enabled": true,
    "cSpell.enabled": true,
    "cSpell.enableFiletypes": [
        "!pug",
        "dockerfile",
        "dotenv",
        "hosts",
        "jsx",
        "jsx-attr",
        "nginx",
        "powershell",
        "sass",
        "styled-css",
        "xml"
    ],
    "debug.console.closeOnEnd": true,
    "diffEditor.codeLens": true,
    "diffEditor.ignoreTrimWhitespace": false,
    "editor.accessibilitySupport": "off",
    "editor.bracketPairColorization.enabled": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.fontFamily": "'FiraCode Nerd Font Mono', Menlo, Consolas, DejaVu Sans Mono, monospace",
    "editor.fontLigatures": true,
    "editor.fontSize": 14,
    "editor.formatOnPaste": true,
    "editor.lineHeight": 24,
    "editor.linkedEditing": true,
    "editor.minimap.renderCharacters": false,
    "editor.multiCursorModifier": "ctrlCmd",
    "editor.renderLineHighlight": "all",
    "editor.renderWhitespace": "selection",
    "editor.showFoldingControls": "always",
    "editor.snippetSuggestions": "top",
    "editor.suggestFontSize": 12,
    "editor.suggestLineHeight": 17,
    "editor.suggestSelection": "first",
    "files.defaultLanguage": "${activeEditorLanguage}",
    "files.insertFinalNewline": true,
    "files.trimTrailingWhitespace": true,
    "git.autofetch": true,
    "git.confirmSync": false,
    "gulp.autoDetect": "on",
    "files.autoSave": "afterDelay",
    "html.format.enable": true,
    "html.format.indentHandlebars": true,
    "html.format.indentInnerHtml": true,
    "html.format.maxPreserveNewLines": 1,
    "html.format.wrapLineLength": 0,
    "javascript.updateImportsOnFileMove.enabled": "always",
    "markdown.preview.breaks": true,
    "markdown.preview.lineHeight": 1.3,
    "peacock.affectStatusAndTitleBorders": true,
    "prettier.requireConfig": true,
    "prettier.singleQuote": true,
    "prettier.tabWidth": 4,
    "prettier.useTabs": true,
    "scss.lint.duplicateProperties": "warning",
    "scss.lint.emptyRules": "ignore",
    "scss.lint.float": "warning",
    "scss.lint.important": "warning",
    "scss.lint.importStatement": "warning",
    "search.useGlobalIgnoreFiles": true,
    "security.workspace.trust.untrustedFiles": "open",
    "typescript.referencesCodeLens.enabled": true,
    "typescript.updateImportsOnFileMove.enabled": "always",
    "window.openFoldersInNewWindow": "on",
    "window.restoreWindows": "all",
    "window.title": "${dirty}${separator}${activeEditorShort}${separator}${rootName}",
    "workbench.colorTheme": "Monokai Pro (Filter Ristretto)",
    "workbench.fontAliasing": "antialiased",
    "workbench.iconTheme": "Monokai Pro (Filter Ristretto) Icons",
    "workbench.list.smoothScrolling": true,
    "workbench.preferredDarkColorTheme": "Monokai Pro (Filter Ristretto)",
    "workbench.preferredHighContrastColorTheme": "Monokai Pro (Filter Ristretto)",
    "workbench.productIconTheme": "icons-carbon",
    "workbench.statusBar.visible": true,
    "workbench.tree.indent": 19,
    "workbench.view.alwaysShowHeaderActions": true,
    "workbench.colorCustomizations": {
        "activityBarBadge.background": "#ffdcda",
        "breadcrumb.activeSelectionForeground": "#feb41f",
        "breadcrumb.foreground": "#5a4f46",
        "editorGroupHeader.tabsBackground": "#1f1919",
        "editorSuggestWidget.highlightForeground": "#a33027",
        "editorWidget.border": "#a33027",
        "editorWidget.resizeBorder": "#a33027",
        "list.activeSelectionForeground": "#ffdcda",
        "list.activeSelectionBackground": "#2c2525",
        "list.highlightForeground": "#feb41f",
        "list.inactiveSelectionForeground": "#ff786e",
        "menu.selectionForeground": "#ff786e",
        "menubar.selectionForeground": "#ff786e",
        "notificationLink.foreground": "#d45a52",
        "panelTitle.activeBorder": "#ff786e",
        "pickerGroup.foreground": "#f38e71",
        "progressBar.background": "#a33027",
        "scrollbarSlider.activeBackground": "#ffdcda",
        "settings.headerForeground": "#ff786e",
        "settings.modifiedItemForeground": "#feb41f",
        "settings.modifiedItemIndicator": "#a33027",
        "sideBar.background": "#1f1919",
        "statusBar.background": "#1f1919",
        "statusBar.debuggingBackground": "#263238",
        "statusBar.foreground": "#7e6f64",
        "statusBar.noFolderBackground": "#1f1919",
        "statusBarItem.remoteBackground": "#1f1919",
        "statusBarItem.remoteForeground": "#96615d",
        "tab.activeBorder": "#1a1a1a",
        "tab.activeBorderTop": "#a33027",
        "tab.border": "#1f1919",
        "tab.inactiveBackground": "#1f1919",
        "textLink.foreground": "#ff786e",
        "titleBar.activeBackground": "#1f1919",
        "titleBar.activeForeground": "#a79c9b",
    },
    "peacock.favoriteColors": [
        {
            "name": "Dark A",
            "value": "#1f1919"
        },
        {
            "name": "Dark B",
            "value": "#1a1a1a"
        }
    ],
    "files.associations": {
        "*.hbs": "handlebars",
        "*.yaml": "yaml",
        "*.conf": "nginx"
    },
    "search.exclude": {
        "**/build": true
    },
    "[css]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[dotenv]": {
        "editor.defaultFormatter": "foxundermoon.shell-format"
    },
    "[handlebars]": {
        "editor.defaultFormatter": "vscode.html-language-features"
    },
    "[html]": {
        "editor.defaultFormatter": "vscode.html-language-features"
    },
    "[javascript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[javascriptreact]": {
        "editor.defaultFormatter": "vscode.typescript-language-features"
    },
    "[json]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[jsonc]": {
        "editor.defaultFormatter": "vscode.json-language-features"
    },
    "[markdown]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "files.trimTrailingWhitespace": false
    },
    "[scss]": {
        "editor.defaultFormatter": "vscode.css-language-features"
    },
    "[typescript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[typescriptreact]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[yaml]": {
        "editor.defaultFormatter": "redhat.vscode-yaml"
    },
    "workbench.editorAssociations": {
        "*.ipynb": "jupyter.notebook.ipynb"
    },
    "[svg]": {
        "editor.defaultFormatter": "jock.svg"
    },
    "editor.unicodeHighlight.ambiguousCharacters": false,
    "markdown-preview-enhanced.enableExtendedTableSyntax": true,
    "cSpell.language": "en-US",
    "terminal.integrated.allowMnemonics": true,
    "terminal.integrated.defaultProfile.osx": "zsh",
    "terminal.integrated.fontFamily": "'FiraCode Nerd Font Mono', Menlo, Consolas, DejaVu Sans Mono, monospace",
    "terminal.integrated.fontSize": 13,
    "[shellscript]": {
        "editor.defaultFormatter": "foxundermoon.shell-format"
    },
    "markdown.updateLinksOnFileMove.enabled": "prompt",
    "markdown.extension.list.indentationSize": "inherit",
    "markdown.extension.print.includeVscodeStylesheets": false,
    "markdownlint.run": "onSave",
    "files.eol": "\n",
    "prettier.endOfLine": "lf",
    "prettier.htmlWhitespaceSensitivity": "strict",
    "editor.colorDecoratorsActivatedOn": "click",
    "editor.defaultColorDecorators": "auto",
    "editor.colorDecoratorsLimit": 200,
    "workbench.editor.empty.hint": "hidden",
    "application.shellEnvironmentResolutionTimeout": 100,
    "workbench.startupEditor": "none",
    "git.allowNoVerifyCommit": true,
    "refreshNpmPackages.npmDefault": "npm i",
    "[NGINX]": {
        "editor.defaultFormatter": "hangxingliu.vscode-nginx-conf-hint"
    },
    "[nginx]": {
        "editor.tabSize": 4,
        "editor.defaultFormatter": "ahmadalli.vscode-nginx-conf"
    },
    "security.workspace.trust.enabled": false,
    "redhat.telemetry.enabled": true,
    "yaml.format.singleQuote": true,
    "npm.enableRunFromFolder": true,
    "[astro]": {
        "editor.defaultFormatter": "astro-build.astro-vscode"
    },
    "colorize.decoration_type": "underline",
    "colorize.languages": [
        "css",
        "js",
        "sass",
        "scss",
        "less",
        "postcss",
        "sss",
        "stylus",
        "xml",
        "svg",
        "javascript",
        "ts",
        "typescript"
    ],
    "eslint.enable": false,
    "docker.extension.enableComposeLanguageServer": false,
    "terminal.integrated.sendKeybindingsToShell": true,
    "yaml.schemas": {},
    "docker.extension.dockerEngineAvailabilityPrompt": false,
    "chat.mcp.gallery.enabled": true,
    "gitlens.ai.model": "gemini:gemini-3-flash-preview",
    "gitlens.ai.vscode.model": "copilot:gpt-4.1",
    "atlascode.bitbucket.enabled": false,
    "atlascode.jira.enabled": true,
    "workbench.activityBar.location": "bottom",
    "svg.preview.mode": "svg",
    "claudeCode.preferredLocation": "sidebar",
    "python.defaultInterpreterPath": "/opt/homebrew/bin/python3",
    "chat.useClaudeHooks": true,
    "claudeCode.selectedModel": "opus[1m]",
    "gitlens.ai.ollama.url": "http://localhost:11434",
    "generate-local-commit.model": "llama3.2:latest",
    "generate-local-commit.contextRange": 6,
    "generate-local-commit.showDiffConfirmation": true,
    "continue.enableNextEdit": false,
    "continue.enableTabAutocomplete": false,
    "chat.agent.maxRequests": 500,
    "security.promptForLocalFileProtocolHandling": false,
    "chat.exploreAgent.defaultModel": "Claude Opus 4.6 (claude-code)",
    "chat.planAgent.defaultModel": "Claude Opus 4.6 (claude-code)",
    "githubPullRequests.createOnPublishBranch": "never",
    "git.ignoreRebaseWarning": true,
    "git-graph.sourceCodeProviderIntegrationLocation": "More Actions",
    "gitHistory.sourceCodeProviderIntegrationLocation": "More Actions",
    "geminicodeassist.codeGenerationPaneViewEnabled": true,
    "geminicodeassist.agentDebugMode": true,
    "geminicodeassist.chat.changeView": "Default diff view",
    "geminicodeassist.inlineSuggestions.suggestionSpeed": "Slow",
    "geminicodeassist.updateChannel": "Default",
    "python.analysis.typeCheckingMode": "basic",
    "makefile.configureOnOpen": true,
    "chat.viewSessions.orientation": "stacked",
    "workbench.preferredHighContrastLightColorTheme": "Monokai Pro Light",
    "workbench.preferredLightColorTheme": "Monokai Pro Light (Filter Sun)",
    "chat.unifiedAgentsBar.enabled": true,
    "yaml.disableSchemaDetection": [
        "**/.github/workflows/*.yml",
        "**/.github/workflows/*.yaml",
        "**/.gitea/workflows/*.yml",
        "**/.gitea/workflows/*.yaml",
        "**/.forgejo/workflows/*.yml",
        "**/.forgejo/workflows/*.yaml"
    ],
}
