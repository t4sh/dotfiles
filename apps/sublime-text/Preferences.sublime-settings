{
    "added_words": [
        "https",
        "www",
    ],
    "ignored_packages": [
        "Vintage",
    ],
    "line_numbers": true,
    "always_show_minimap_viewport": true,
    "auto_complete": false,
    "bold_folder_labels": false,
    "caret_extra_bottom": 2,
    "caret_extra_top": 2,
    "caret_extra_width": 2,
    "caret_style": "wide",
    "draw_minimap_border": true,
    "ensure_newline_at_eof_on_save": true,
    "fade_fold_buttons": true,
    // "font-face": [
    //     "FiraCode Nerd Font Mono",
    //     "Courier New",
    //     "Menlo",
    //     "Monaco",
    //     "Source Code Pro",
    //     "Letter Gothic Std",
    //     "Consolas",
    //     "monospace"
    // ],
    "font_face": "FiraCode Nerd Font Mono",

    "font_options": [
        "gray_antialias",
        "subpixel_antialias"
    ],
    "font_size": 16,
    "highlight_line": true,
    "highlight_modified_tabs": false,
    "indent_guide_options": [
        "draw_normal",
        "draw_active"
    ],
    "index_files": true,
    "line_padding_bottom": 5,
    "line_padding_top": 5,
    "margin": 8,
    "match_brackets_angle": true,
    "open_files_in_new_window": false,
    "overlay_scroll_bars": "enabled",
    "show_line_endings": true,
    "spell_check": true,
    "trim_trailing_white_space_on_save": true,

    // isolate color scheme //
    // "theme": "gruvbox.sublime-theme",
    // "color_scheme": "Monokai Pro (Filter Ristretto).sublime-color-scheme",

    // isolate color scheme //
    "theme": "gruvbox.sublime-theme",
    "color_scheme": "Monokai Pro (Filter Ristretto).sublime-color-scheme",

    // theme/color-scheme specific options //
    "gruvbox_accent_yellow": true,
    "gruvbox_autocomplete_border": true,
    "gruvbox_colored_tooltips": true,
    "gruvbox_command_palette_compact": true,
    "gruvbox_panel_xxs": true,
    "gruvbox_sidebar_comfortable": true,
    "gruvbox_sideline_autocomplete_row": true,
    "gruvbox_sideline_command_palette_row": true,
    "gruvbox_sideline_command_palette_row_thickest": true,
    "gruvbox_statusbar_button_xxs": true,
    "gruvbox_tabs_autowidth": true,
    "gruvbox_tabs_xxs": true,
    "gruvbox_underline_active_tab": true,
    "gruvbox_underline_modified_tabs": false,
}
