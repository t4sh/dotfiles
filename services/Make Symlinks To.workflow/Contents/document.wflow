				<key>AMRequiredResources</key>
				<array/>
				<key>ActionBundlePath</key>
				<string>/System/Library/Automator/Run Shell Script.action</string>
				<key>ActionName</key>
				<string>Run Shell Script</string>
				<key>ActionParameters</key>
				<dict>
					<key>COMMAND_STRING</key>
					<string>#!/bin/zsh
set -u

(( $# )) || exit 0

# Append a sentinel so command substitution preserves newlines in folder names.
selection=$(/usr/bin/osascript &lt;&lt;'APPLESCRIPT'
try
    set destinationFolder to choose folder with prompt "Choose where to create the symlinks:"
    return (POSIX path of destinationFolder) &amp; "."
on error messageText number errorNumber
    if errorNumber is not -128 then display alert "Make Symlinks To…" message messageText
    return ""
end try
APPLESCRIPT
) || exit 0
[[ -n "$selection" ]] || exit 0
destination=${selection%.}

created=0
skipped=0
failed=0
for source in "$@"; do
    source=${source%/}
    name=${source:t}
    target="${destination}${name}"
    if [[ -e "$target" || -L "$target" ]]; then
        (( skipped += 1 ))
    elif [[ "$source" != /* || ! -e "$source" &amp;&amp; ! -L "$source" ]]; then
        (( failed += 1 ))
    # symlink(2) fails atomically if the destination exists, including directories.
    elif /usr/bin/perl -e 'symlink($ARGV[0], $ARGV[1]) or exit 1' -- "$source" "$target"; then
        (( created += 1 ))
    else
        (( failed += 1 ))
    fi
done

/usr/bin/osascript - "$created" "$skipped" "$failed" &lt;&lt;'APPLESCRIPT'
on run counts
    set summaryText to (item 1 of counts) &amp; " symlink(s) created."
    if item 2 of counts is not "0" then set summaryText to summaryText &amp; return &amp; (item 2 of counts) &amp; " skipped: a destination item already exists."
    if item 3 of counts is not "0" then set summaryText to summaryText &amp; return &amp; (item 3 of counts) &amp; " failed: check source availability and destination permissions."
    if item 2 of counts is not "0" or item 3 of counts is not "0" then
        display alert "Make Symlinks To…" message summaryText
    else
        display notification summaryText with title "Make Symlinks To…"
    end if
end run
APPLESCRIPT
exit 0
</string>
					<key>CheckedForUserDefaultShell</key>
