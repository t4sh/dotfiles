				<dict>
					<key>Container</key>
					<string>List</string>
					<key>Types</key>
					<array>
						<string>com.apple.cocoa.string</string>
					</array>
				</dict>
				<key>ActionBundlePath</key>
				<string>/System/Library/Automator/Run Shell Script.action</string>
				<key>ActionName</key>
				<string>Run Shell Script</string>
				<key>ActionParameters</key>
				<dict>
					<key>COMMAND_STRING</key>
					<string>#!/bin/zsh
set -u

export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"

escape_applescript() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  print -r -- "$s"
}

notify() {
  local msg="$(escape_applescript "$1")"
  /usr/bin/osascript -e "display notification \"$msg\" with title \"pdf-compress-clean\"" &gt;/dev/null 2&gt;&amp;1 || true
}

alert() {
  local msg="$(escape_applescript "$1")"
  /usr/bin/osascript -e "display alert \"pdf-compress-clean\" message \"$msg\" as warning" &gt;/dev/null 2&gt;&amp;1 || true
}

missing=()
for cmd in gs exiftool qpdf pdfinfo; do
  if ! command -v "$cmd" &gt;/dev/null 2&gt;&amp;1; then
    missing+=("$cmd")
  fi
done

if (( ${#missing[@]} &gt; 0 )); then
  alert "Missing required command(s): ${missing[*]}. Run: brew bundle install --file ~/.dotfiles/Brewfile"
  exit 0
fi

if (( $# == 0 )); then
  alert "Select one or more PDF files in Finder, then run this Quick Action."
  exit 0
fi

created=0
failed=0

for input in "$@"; do
  tmpdir=""

  if [[ ! -f "$input" ]]; then
    alert "Not a file: $(basename "$input")"
    (( failed++ ))
    continue
  fi

  ext="${input:e:l}"
  if [[ "$ext" != "pdf" ]]; then
    alert "Not a PDF: $(basename "$input")"
    (( failed++ ))
    continue
  fi

  if ! pdfinfo "$input" &gt;/dev/null 2&gt;&amp;1; then
    alert "Cannot read PDF: $(basename "$input"). File may be corrupt, encrypted, or not a valid PDF."
    (( failed++ ))
    continue
  fi

  dir="${input:h}"
  base="${input:t}"
  stem="${base:r}"
  output="$dir/${stem}-compressed-clean.pdf"

  if [[ -e "$output" ]]; then
    n=2
    while [[ -e "$dir/${stem}-compressed-clean-$n.pdf" ]]; do
      (( n++ ))
    done
    output="$dir/${stem}-compressed-clean-$n.pdf"
  fi

  trap '[[ -n "${tmpdir:-}" &amp;&amp; -d "$tmpdir" ]] &amp;&amp; rm -rf "$tmpdir"' EXIT INT TERM

  tmpdir="$(mktemp -d "${TMPDIR:-/tmp}/compress-strip-pdf.XXXXXX")" || {
    alert "Could not create temporary directory for $(basename "$input")."
    (( failed++ ))
    trap - EXIT INT TERM
    continue
  }

  compressed="$tmpdir/compressed.pdf"
  rebuilt="$tmpdir/rebuilt.pdf"

  if gs -q -dNOPAUSE -dBATCH -dSAFER \
      -sDEVICE=pdfwrite \
      -dCompatibilityLevel=1.7 \
      -dPDFSETTINGS=/ebook \
      -dDetectDuplicateImages=true \
      -dCompressFonts=true \
      -dSubsetFonts=true \
      -dColorImageDownsampleType=/Bicubic \
      -dColorImageResolution=150 \
      -dGrayImageDownsampleType=/Bicubic \
      -dGrayImageResolution=150 \
      -dMonoImageDownsampleType=/Subsample \
      -dMonoImageResolution=300 \
      -sOutputFile="$compressed" \
      "$input" \
    &amp;&amp; exiftool -q -q -overwrite_original -all:all= "$compressed" \
    &amp;&amp; qpdf --linearize "$compressed" "$rebuilt" \
    &amp;&amp; mv "$rebuilt" "$output"; then
      tmpdir=""
      trap - EXIT INT TERM
      (( created++ ))
  else
      alert "Failed to compress $(basename "$input"). File may be corrupt or password-protected."
      (( failed++ ))
  fi

  [[ -n "${tmpdir:-}" &amp;&amp; -d "$tmpdir" ]] &amp;&amp; rm -rf "$tmpdir"
  tmpdir=""
  trap - EXIT INT TERM
done


if (( created &gt; 0 &amp;&amp; failed == 0 )); then
  notify "Created $created cleaned PDF(s)."
elif (( created &gt; 0 )); then
  notify "Created $created cleaned PDF(s); $failed failed."
else
  alert "No PDFs were processed successfully."
  exit 0
fi
</string>
