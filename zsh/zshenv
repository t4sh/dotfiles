# In ~/.zshenv — ensures GUI apps see a minimal PATH.
#
# This file runs before ~/.zshrc, including for new Terminal login shells and
# non-interactive zsh invocations. Keep it deterministic and credential-free.
typeset -U path
path=(
  /opt/homebrew/bin
  /opt/homebrew/sbin
  /usr/local/bin
  /usr/local/sbin
  $path
)
export PATH

[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"

# RTK tracking DB for sandboxed Codex shells.
export RTK_DB_PATH=/private/tmp/rtk-codex/history.db
