# In ~/.zshenv — ensures GUI apps see a minimal PATH.
#
# This file runs before ~/.zshrc, including for new Terminal login shells and
# non-interactive zsh invocations. Keep it small, but make Homebrew available
# before sourcing secrets because ~/.secrets/env.sh may call tools like gh.
typeset -U path
path=(
  /opt/homebrew/bin
  /opt/homebrew/sbin
  /usr/local/bin
  /usr/local/sbin
  $path
)
export PATH

export ZSH_HIGHLIGHT_HIGHLIGHTERS_DIR=/opt/homebrew/share/zsh-syntax-highlighting/highlighters
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"

# Secrets — never committed. Canonical tree: ~/.secrets/ (vault-backed).
# Consumer paths (e.g. ~/.config/gh/hosts.yml, ~/.ssh/*) are symlinks — see symlinks.tsv.
[[ -f ~/.secrets/env.sh ]] && source ~/.secrets/env.sh

# RTK tracking DB for sandboxed Codex shells.
export RTK_DB_PATH=/private/tmp/rtk-codex/history.db
