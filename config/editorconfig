root = true

# LF only — Windows+Mac safe. CRLF breaks shell scripts on macOS.
# Keep editor Prettier files.eol / prettier.endOfLine in sync (lf / \n).

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{sh,zsh,bash}]
indent_size = 4

[Makefile]
indent_style = tab

[*.md]
trim_trailing_whitespace = false
