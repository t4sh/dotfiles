{
  "$schema": "https://opencode.ai/config.json",
  // Hide niche Cloudflare skills from the listing (config-only; skill files stay upstream-managed).
  "permissions": [
    { "action": "skill", "resource": "*", "effect": "allow" },
    { "action": "skill", "resource": "basin", "effect": "deny" },
    { "action": "skill", "resource": "k2", "effect": "deny" },
    { "action": "skill", "resource": "gateway-workers", "effect": "deny" },
    { "action": "skill", "resource": "cloudflare-one-migrations", "effect": "deny" },
    { "action": "skill", "resource": "sandbox-*", "effect": "deny" }
  ],
  "mcp": {
    "servers": {
      "browse": {
        "type": "local",
        "command": [
          "{env:HOME}/.local/bin/browse",
          "mcp"
        ],
        "cwd": "{env:HOME}",
        "pool": true,
        "environment": {
          "OPENCODE_BROWSER_RUNTIME": "auto-update"
        }
      }
    }
  }
}
