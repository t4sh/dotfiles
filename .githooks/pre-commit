#!/usr/bin/env bash
# Pre-commit checks — runs on staged changes only (fast).
# Tracked, dotfiles-managed. Wired via `core.hooksPath .githooks` (set by
# `make hooks`). This is the single source of truth — git/hooks/ is git's
# per-clone area (LFS etc.), never dotfiles hooks.
#
# Checks (in order):
#   1. gitleaks — blocks commits that introduce secrets. Allowlist in .gitleaks.toml.
#   2. shellcheck — warns on shell-script issues (non-blocking).
#   3. skill-license gate — blocks if a restrictive-licensed skill is not
#      gitignored (would leak into the public split). Self-skips pre-bootstrap.
#   4. Skillsfile sync gate — when .skill-lock.json or Skillsfile is staged,
#      blocks if they drifted (regenerate with `make skills-manifest`).
#   5. Rulebook ownership gate — when the index, rules, or init loader changes,
#      blocks membership, applicability, or loader-contract drift.
#
# Bypass (emergencies only): `git commit --no-verify`

set -eu

# Git Bash does not discover PowerShell's python3.cmd shim. Resolve the managed
# interpreter explicitly instead of executing the Windows Store Python alias.
case "${OS:-}:$(uname -s)" in
  Windows_NT:*|*:MINGW*|*:MSYS*)
    command -v uv >/dev/null 2>&1 || {
      echo 'Windows hooks need uv and managed Python; run install.ps1 -Apply.' >&2
      exit 1
    }
    PYTHON_BIN="$(uv python find --managed-python)" || exit 1
    PYTHON_BIN="$(cygpath -u "$PYTHON_BIN")"
    [[ -x "$PYTHON_BIN" ]] || { echo 'Managed Python is not executable.' >&2; exit 1; }
    export PYTHON_BIN
    ;;
esac

# --- 1. gitleaks --------------------------------------------------------------
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks git --pre-commit --staged --redact --no-banner || {
    printf '\n\033[31m✗ commit blocked: secret detected in staged changes\033[0m\n' >&2
    printf '  fix:    remove the secret, amend or reset, re-stage\n' >&2
    printf '  bypass: git commit --no-verify  (only if you are certain)\n' >&2
    exit 1
  }
else
  printf '\033[33m  ⚠\033[0m gitleaks not installed — skipping secret scan\n' >&2
  printf '       install: brew install gitleaks\n' >&2
fi

# --- 2. shellcheck (non-blocking warning pass) --------------------------------
# Lints staged *.sh files plus any extensionless script with a bash/sh shebang
# (e.g. bin/dot). To make blocking, remove the `|| true` at the end.
if command -v shellcheck >/dev/null 2>&1; then
  staged_sh=()
  while IFS= read -r -d '' f; do
    [ -z "$f" ] && continue
    case "$f" in
      *.sh)
        staged_sh+=("$f")
        ;;
      *)
        # extensionless: sniff the shebang
        if [ -f "$f" ] && head -n1 "$f" 2>/dev/null | grep -Eq '^#![[:space:]]*((/usr/bin/env[[:space:]]+(-S[[:space:]]+)?(bash|sh))|(/(usr/)?bin/(bash|sh)))([[:space:]]|$)'; then
          staged_sh+=("$f")
        fi
        ;;
    esac
  done < <(git diff --cached --name-only --diff-filter=ACMR -z)

  if ((${#staged_sh[@]} > 0)); then
    shellcheck -S warning "${staged_sh[@]}" || {
      printf '\033[33m  ⚠ shellcheck reported issues (non-blocking)\033[0m\n' >&2
    }
  fi
else
  printf '\033[33m  ⚠\033[0m shellcheck not installed — skipping lint\n' >&2
  printf '       install: brew install shellcheck\n' >&2
fi

# --- 3. skill-license gate (blocking) -----------------------------------------
# Blocks the commit if a skill's redistribution status needs review or a
# restrictive license is not gitignored. Self-skips pre-bootstrap.
if [ -x scripts/audit-skill-licenses.sh ]; then
  scripts/audit-skill-licenses.sh --check || {
    printf '\n\033[31m✗ commit blocked: skill license audit requires attention\033[0m\n' >&2
    printf '  fix:    review the audit output above, then update metadata or gate the skill\n' >&2
    printf '  bypass: git commit --no-verify     (only if you are certain)\n' >&2
    exit 1
  }
fi

# --- 4. Skillsfile sync gate (blocking, only when the manifest changed) --------
# .skill-lock.json (the source) and Skillsfile (the generated manifest) must
# move together. Only fires when either is staged, so unrelated commits aren't
# coupled to python3 / a clean tree.
# Newline-mode grep -xE (not -z): BSD grep on macOS doesn't honor --null-data.
# Both paths are fixed, newline-free names, so line matching is safe.
if git diff --cached --name-only --diff-filter=ACMR \
   | grep -qxE 'agents/\.skill-lock\.json|Skillsfile'; then
  if [[ -n "${PYTHON_BIN:-}" ]] || command -v python3 >/dev/null 2>&1; then
    "${PYTHON_BIN:-python3}" scripts/gen-skillsfile.py --check || {
      printf '\n\033[31m✗ commit blocked: Skillsfile out of sync with .skill-lock.json\033[0m\n' >&2
      printf '  fix:    make skills-manifest   (regenerates + re-stage Skillsfile)\n' >&2
      printf '  bypass: git commit --no-verify\n' >&2
      exit 1
    }
  else
    printf '\033[33m  ⚠\033[0m python3 not found — skipping Skillsfile sync check\n' >&2
  fi
fi

# --- 5. Rulebook ownership gate (blocking, only for rulebook changes) ---------
if git diff --cached --name-only --diff-filter=ACMR \
   | grep -qE '^agents/AGENTS\.md$|^agents/rules/[^/]+\.md$|^agents/skills/init-rulebook/SKILL\.md$'; then
  scripts/audit-rules.sh || {
    printf '\n\033[31m✗ commit blocked: rulebook ownership contract drifted\033[0m\n' >&2
    printf '  fix:    make rules-audit\n' >&2
    printf '  bypass: git commit --no-verify\n' >&2
    exit 1
  }
fi
