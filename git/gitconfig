[mergetool]
	keepBackup = true
	prompt = false
[user]
	name = tAsh
	email = t4sh@users.noreply.github.com
	signingkey = ~/.ssh/github_ed25519.pub
[core]
	filemode = false
	pager = delta
[init]
	defaultBranch = main
[push]
	autoSetupRemote = true
	followTags = true
[fetch]
	prune = true
[diff]
	algorithm = histogram
	colorMoved = default
[difftool]
	prompt = false
	trustExitCode = true
[rebase]
	autostash = true
	autosquash = true
[rerere]
	enabled = true
[help]
	autocorrect = prompt
[log]
	date = iso
[alias]
	s = status
	co = checkout
	lga = log --oneline --decorate --graph --all -40
	root = rev-parse --show-toplevel
	aliases = !git config --get-regexp '^alias\\.' | sed 's/^alias\\.//'
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	line-numbers = true
	side-by-side = false
	syntax-theme = TwoDark
	plus-style = syntax "#003800"
	minus-style = syntax "#3f0001"
	file-style = bold yellow
	hunk-header-style = file line-number syntax
	hyperlinks = true
[merge]
	conflictstyle = zdiff3
[gpg]
	format = ssh
[commit]
	gpgsign = true
[tag]
	gpgsign = true
[gpg "ssh"]
	allowedSignersFile = ~/.ssh/allowed_signers
[include]
	path = ~/.gitconfig-platform
