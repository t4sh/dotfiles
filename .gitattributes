# Keep text checkouts LF-only even when a Windows Git client has
# core.autocrlf=true. Binary files remain binary through text=auto detection.
* text=auto eol=lf

# Render plist files as text in `git diff`, `git log -p`, `git show`, and
# diff viewers that honor git attributes. Requires matching textconv in
# .git/config (set by `git config diff.plist.textconv "plutil -p"`).
*.plist diff=plist
